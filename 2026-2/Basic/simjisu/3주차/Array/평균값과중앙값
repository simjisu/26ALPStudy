#include <iostream>
#include <algorithm>
using namespace std;

int arr[6];

int main() {
	cin >> arr[0] >> arr[1] >> arr[2] >> arr[3] >> arr[4];

	int avg;
	int med;
	int sum;

	sum = arr[0] + arr[1] + arr[2] + arr[3] + arr[4];
	avg = sum / 5;

	sort(arr, arr + 5);

	med = arr[2];

	cout << avg << "\n" << med;

	return 0;
}
