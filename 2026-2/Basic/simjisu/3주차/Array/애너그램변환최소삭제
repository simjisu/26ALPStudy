#include <iostream>
#include <string>
using namespace std;

char c1[1001];

int main() {
	string s1;
	string s2;

	cin >> s1;
	cin >> s2;

	for (int i = 0; i < s1.size(); i++) {
		c1[i] = s1[i];
	}

	int cnt = 0;

	for (int i = 0; i < s2.size(); i++) {
		for (int j = 0; j < s1.size(); j++) {
			if (s2[i] == c1[j]) {
				c1[j] = 0;
				cnt++;
				break;
			}
		}
	}

	int n = s1.size() + s2.size() - 2 * cnt;
	cout << n;

	return 0;
}
